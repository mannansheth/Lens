{
  "name": "@lens-rag/client",
  "version": "0.1.0",
  "description": "Dependency-free Node.js client for the Lens local HTTP API",
  "type": "module",
  "engines": { "node": ">=18" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": { "build": "node ./scripts/build.mjs", "test": "node --test" },
  "publishConfig": { "access": "public" }
}
