APP_NAME=Lens
DATABASE_URL=postgresql://lens:lens_local@127.0.0.1:55432/lens
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=.models
LOG_LEVEL=INFO
HYBRID_ALPHA=0.5
# Used only by ask; existing retrieval/embedding configuration is unchanged.
LLM_PROVIDER=ollama
LLM_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
LLM_TIMEOUT=600
LLM_TEMPERATURE=0
LLM_CONTEXT_TOKENS=32768
LLM_CONTEXT_CHARS=12000
LLM_OUTPUT_TOKENS=1024
# Optional official Google API; local Ollama never requires this key.
GEMINI_API_KEY=
# Gemini uses min(LLM_TIMEOUT, 60) seconds per attempt by default; optional override:
# GEMINI_TIMEOUT=60
# CLI overrides > saved provider/model > LLM_PROVIDER/LLM_MODEL > Ollama 8B.
# Gemini is an explicit remote choice: selected source evidence goes to Google.
# Set LENS_ENV_FILE or LENS_STATE_DIR to use custom local configuration/state paths.
# State defaults to the operating system local-data directory under Lens.
